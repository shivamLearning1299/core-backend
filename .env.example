NODE_ENV=development
PORT=3000

# Postgres host is the docker-compose service name here (used by api/worker/socket
# containers). Must match the hardcoded POSTGRES_USER/PASSWORD/DB in docker-compose.yml.
DATABASE_URL=postgresql://core_user:core_password@postgres:5432/core_db

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30
