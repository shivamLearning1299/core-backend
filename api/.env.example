NODE_ENV=development
PORT=3000

# Postgres host is localhost here (for running `npm run start:dev` outside Docker,
# against the postgres container's published port). Must match the hardcoded
# POSTGRES_USER/PASSWORD/DB in the root docker-compose.yml.
DATABASE_URL=postgresql://core_user:core_password@localhost:5432/core_db

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# Origin allowed to call this API from a browser (the Next.js dashboard-frontend
# dev server). No cookies are used (Bearer tokens only), so this is the only
# CORS setting needed.
FRONTEND_ORIGIN=http://localhost:3002
